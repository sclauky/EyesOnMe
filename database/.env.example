# Copier en .env (jamais versionné) et remplacer par de vrais secrets :
#   openssl rand -base64 32 | tr -d '/+=' 
EYESONME_DB=eyesonme
# Rôle propriétaire du schéma, utilisé par dbmate (migrations)
EYESONME_OWNER_PASSWORD=change-me-owner
# Rôle applicatif (DML seulement), utilisé par l'API
EYESONME_APP_PASSWORD=change-me-app
